[Unit]
Description=IVAR Document Sync local control panel

[Service]
Type=simple
WorkingDirectory=%h/Documents/.auto-tasks
ExecStart=%h/Documents/.auto-tasks/.venv-docsync/bin/python %h/Documents/.auto-tasks/doc-sync-app.py --port 8787
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
